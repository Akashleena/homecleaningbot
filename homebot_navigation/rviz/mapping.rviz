Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1/Frames1
    Splitter Ratio: 0.5
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
    Splitter Ratio: 0.58
  - Class: rviz_common/Views
    Name: Views
    Splitter Ratio: 0.5
  - Class: rviz_common/Time
    Name: Time
    SyncMode: 0
    SyncSource: LaserScan
  - Class: slam_toolbox::SlamToolboxPlugin
    Name: SlamToolboxPlugin

Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Plane Cell Count: 10
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
      TF Prefix: ""
      Visual Enabled: true
      Collision Enabled: false

    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Marker Scale: 1
      Frames:
        All Enabled: false
        map:
          Value: true
        odom:
          Value: true
        chassis:
          Value: true
        lidar_link:
          Value: true
        imu_link:
          Value: true
        bumper_link:
          Value: true
        torso:
          Value: false
        front_left_wheel:
          Value: false
        front_right_wheel:
          Value: false
        rear_left_wheel:
          Value: false
        rear_right_wheel:
          Value: false

    - Class: rviz_default_plugins/LaserScan
      Name: LaserScan
      Enabled: true
      Topic:
        Value: /diff_drive/scan
      Style: Flat Squares
      Size (Pixels): 3
      Use Fixed Frame: true
      Color Transformer: Intensity

    - Class: rviz_imu_plugin/Imu
      Name: Imu
      Enabled: true
      Topic:
        Value: /imu
      fixed_frame_orientation: true

    - Class: rviz_default_plugins/InteractiveMarkers
      Name: InteractiveMarkers
      Enabled: true
      Interactive Markers Namespace: /twist_server
      Show Axes: false
      Show Descriptions: false
      Show Visual Aids: false
      Enable Transparency: true

    - Class: rviz_default_plugins/Map
      Name: Map
      Enabled: true
      Topic:
        Value: /map
      Update Topic:
        Value: /map_updates
      Color Scheme: map
      Use Timestamp: false

  Enabled: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
    Background Color: 48; 48; 48
  Name: root

  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Topic:
        Value: /clicked_point
      Single click: true

  Transformation:
    Current:
      Class: rviz_default_plugins/TF

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Pitch: 1.0
      Yaw: 2.6
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Target Frame: <Fixed Frame>

Window Geometry:
  Height: 1200
  Width: 1800
  X: 100
  Y: 50
  Hide Left Dock: false
  Hide Right Dock: false